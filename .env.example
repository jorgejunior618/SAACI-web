# Copie este arquivo e preencha os valores. Os arquivos .env.*.local são ignorados pelo git.
#   .env.development.local  Supabase local do Docker (pnpm db:start), lido por `pnpm dev`.
#   .env.production.local   Supabase remoto, lido por `pnpm build` e `pnpm start`.
# Este arquivo guarda só os nomes das variáveis. Nunca coloque valor aqui.
# Passo a passo no README, seção "Supabase".

# URL do projeto Supabase (Connect ou Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable (sb_publishable_...). Pode ir ao navegador, a segurança vem do RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A chave secret (sb_secret_...), antiga service_role, NÃO entra aqui nem em variável NEXT_PUBLIC_.

# Na Vercel não há arquivo: as variáveis deste arquivo entram em Settings > Environment Variables do
# projeto, só no ambiente Production (ADR 0019). `BREVO_SMTP_USER` e `BREVO_SMTP_KEY` não vão para
# a Vercel: a CLI do Supabase as lê do seu terminal no `config push`.

# Chave da API do Gemini (Google AI Studio). Só no servidor, lida pelo Route Handler de leitura do
# comprovante (RF41, ADR 0016). Nunca com prefixo NEXT_PUBLIC_.
GEMINI_API_KEY=

# Opcional. ID do modelo. Vazio usa o padrão do código (gemini-3.1-flash-lite, com camada gratuita).
GEMINI_MODEL=
