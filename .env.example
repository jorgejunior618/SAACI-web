# Copie este arquivo e preencha os valores. Os arquivos .env.*.local são ignorados pelo git.
#   .env.development.local  Supabase local do Docker (pnpm db:start), lido por `pnpm dev`.
#   .env.production.local   Supabase remoto, lido por `pnpm build` e `pnpm start`.
# Este arquivo guarda só os nomes das variáveis. Nunca coloque valor aqui.
# Passo a passo no README, seção "Supabase".

# URL do projeto Supabase (Connect ou Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable (sb_publishable_...). Pode ir ao navegador, a segurança vem do RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A chave secret (sb_secret_...), antiga service_role, NÃO entra aqui nem em variável NEXT_PUBLIC_.
